{
    "version": "https://jsonfeed.org/version/1",
    "title": "{{ config.title }}",
    "home_page_url": "{{ config.base_url | safe }}",
    "feed_url": "{{ feed_url | safe }}",
    "description": "{{ config.description }}",
    "items": [
        {%- for page in pages %}
        {
            "id": "{{ page.permalink | safe }}",
            "url": "{{ page.permalink | safe }}",
            "title": "{{ page.title }}",
            "summary": "{% if page.description %}{{ page.description }}{% else %}{{ page.summary | json_encode(pretty=true) | safe }}{% endif %}",
            "date_published": "{{ page.date | date(format='%Y-%m-%dT%H:%M:%S%:z') }}",
            "date_modified" : "{{ page.updated | default(value=page.date, boolean=true) | date(format='%Y-%m-%dT%H:%M:%S%:z') }}"
        }{% if not loop.last %},{% else %}{% endif %}
        {%- endfor %}
    ]
}
